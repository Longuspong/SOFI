# Kopiere diese Datei zu ".env" und trage deinen persönlichen Key ein.
# Einen kostenlosen Key erhältst du unter https://openrouter.ai:
# 1. Mit E-Mail-Adresse oder Google-/GitHub-Konto registrieren (kein Kreditkarte nötig).
# 2. Oben rechts auf deinen Account-Namen -> "Keys" -> "Create Key".
# 3. Den angezeigten Key hier unten anstelle von "dein_key_hier" einsetzen.
OPENROUTER_API_KEY=dein_key_hier

# Modellname ist optional - Standardwert im Code ist bereits "openrouter/free".
# Falls dieses Modell nicht mehr verfügbar ist, hier ein aktuelles ":free"-Modell
# von https://openrouter.ai/models (Filter "Free") eintragen.
MODEL_NAME=openrouter/free
